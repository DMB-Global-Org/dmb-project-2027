# Backend against the local docker-compose database (postgres-dev, port 5435).
# Copy to backend/.env.docker (git-ignored) and run `pnpm --filter backend dev:local`.
# Variables set this way win over backend/.env, so production is never touched.
PORT=8000
DATABASE_URL="postgres://postgres:postgres@localhost:5435/dmb_dev"
DATABASE_DIRECT_URL="postgres://postgres:postgres@localhost:5435/dmb_dev"
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Never send real e-mail from a copy of production data.
MAIL_DRIVER=console
