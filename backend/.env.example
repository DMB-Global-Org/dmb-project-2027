PORT=8000

# CORS: comma-separated exact origins, plus an optional regex (e.g. Vercel previews)
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_PATTERN=^https://dmb-project-2027-[a-z0-9-]+-dmb-global-org\.vercel\.app$

# Supabase → Connect. Passwords must be URL-encoded (e.g. @ → %40, # → %23).
# App runtime: transaction-mode pooler (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations (drizzle-kit): direct connection or session-mode pooler (port 5432)
DATABASE_DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Public address of the frontend (registration links are built from it).
# APP_BASE_URL=http://localhost:3000

# Sessions: how long a login lasts (days) and how many reverse proxies sit in
# front of the app (e.g. 2 behind Vercel + Render) so req.ip is the client IP.
# SESSION_TTL_DAYS=14
# TRUST_PROXY_HOPS=0

# Integration tests (pnpm test:int): local Postgres from docker-compose.yml.
# The database name must end with "_test"; tests drop and recreate schemas.
# DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5434/dmb_test
